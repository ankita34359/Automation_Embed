# Names only. Copy to .env and type the values yourself; .env is never committed or uploaded.
# On Embarko, set the same names in the app's environment settings.

# Public ids of this viaSocket workspace
VIASOCKET_ORG_ID=80141
VIASOCKET_PROJECT_ID=projKcrymrh3

# Secret: viaSocket -> Integrations -> the embed -> Install Code
VIASOCKET_EMBED_SECRET=

# The HR admin's stable viaSocket identity. hiredrive-hr-admin-local locally, hiredrive-hr-admin on Embarko.
# Never change it once HR has connected apps, or they appear to lose them.
VIASOCKET_UNIQUE_ID=

# HR admin password and the key that signs the login cookie (use a long random string)
ADMIN_PASSWORD=
SESSION_SECRET=
